{
  "openapi": "3.0.0",
  "info": {
    "title": "Todo API",
    "description": "API for a TODO application - CSE341 Project. Authentication uses GitHub OAuth. Visit /login to sign in and /logout to sign out. All todo routes require login and only return or modify todos created by the logged-in user. To demo in Swagger: open /login in this same browser, then use Try it out on /api-docs (the session cookie is sent automatically).",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "GitHub OAuth login and logout"
    },
    {
      "name": "Categories",
      "description": "Category endpoints"
    },
    {
      "name": "Todos",
      "description": "Todo endpoints scoped to the logged-in user"
    }
  ],
  "paths": {
    "/login": {
      "get": {
        "tags": ["Auth"],
        "summary": "Login with GitHub",
        "description": "Redirects the user to GitHub to create an account or log in. After success, the user is redirected back to /.",
        "responses": {
          "302": {
            "description": "Redirect to GitHub OAuth"
          }
        }
      }
    },
    "/github/callback": {
      "get": {
        "tags": ["Auth"],
        "summary": "GitHub OAuth callback",
        "description": "GitHub redirects here after login. Creates a new user account if it does not exist yet.",
        "responses": {
          "302": {
            "description": "Redirect to home on success or to /api-docs on failure"
          }
        }
      }
    },
    "/logout": {
      "get": {
        "tags": ["Auth"],
        "summary": "Logout",
        "description": "Logs the current user out and ends the session.",
        "responses": {
          "302": {
            "description": "Redirect to home after logout"
          }
        }
      }
    },
    "/user": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get current logged in user",
        "description": "Returns the current user if logged in. Requires authentication.",
        "security": [
          {
            "githubOAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User is logged in",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "You are logged in"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not logged in"
          }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": ["Categories"],
        "summary": "Get all categories",
        "responses": {
          "200": {
            "description": "List of all categories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "tags": ["Categories"],
        "summary": "Create a new category",
        "description": "Requires login with GitHub OAuth.",
        "security": [
          {
            "githubOAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryInput"
              },
              "example": {
                "name": "School",
                "description": "Tasks related to school",
                "color": "blue"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Category created successfully"
          },
          "400": {
            "description": "Validation error - missing or invalid fields"
          },
          "401": {
            "description": "Unauthorized - you must be logged in"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/categories/{id}": {
      "get": {
        "tags": ["Categories"],
        "summary": "Get a category by id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Category id"
          }
        ],
        "responses": {
          "200": {
            "description": "Category found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "400": {
            "description": "Invalid category id"
          },
          "404": {
            "description": "Category not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "put": {
        "tags": ["Categories"],
        "summary": "Update a category by id",
        "description": "Requires login with GitHub OAuth.",
        "security": [
          {
            "githubOAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Category id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryInput"
              },
              "example": {
                "name": "Work",
                "description": "Tasks related to work",
                "color": "green"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Category updated successfully"
          },
          "400": {
            "description": "Validation error - missing or invalid fields"
          },
          "401": {
            "description": "Unauthorized - you must be logged in"
          },
          "404": {
            "description": "Category not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "delete": {
        "tags": ["Categories"],
        "summary": "Delete a category by id",
        "description": "Requires login with GitHub OAuth.",
        "security": [
          {
            "githubOAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Category id"
          }
        ],
        "responses": {
          "200": {
            "description": "Category deleted successfully"
          },
          "400": {
            "description": "Invalid category id"
          },
          "401": {
            "description": "Unauthorized - you must be logged in"
          },
          "404": {
            "description": "Category not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/todos": {
      "get": {
        "tags": ["Todos"],
        "summary": "Get all todos for the logged-in user",
        "description": "Requires login with GitHub OAuth. Returns only todos created by the current user.",
        "security": [
          {
            "githubOAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of todos belonging to the logged-in user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Todo"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - you must be logged in"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "tags": ["Todos"],
        "summary": "Create a new todo",
        "description": "Requires login with GitHub OAuth. The new todo is automatically linked to the logged-in user.",
        "security": [
          {
            "githubOAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TodoInput"
              },
              "example": {
                "title": "Study for exam",
                "description": "Review chapters 1 to 5",
                "completed": false,
                "priority": "high",
                "dueDate": "2026-07-25",
                "categoryId": "507f1f77bcf86cd799439011"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Todo created successfully"
          },
          "400": {
            "description": "Validation error - missing or invalid fields"
          },
          "401": {
            "description": "Unauthorized - you must be logged in"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/todos/{id}": {
      "get": {
        "tags": ["Todos"],
        "summary": "Get a todo by id",
        "description": "Requires login with GitHub OAuth. Returns the todo only if it belongs to the logged-in user.",
        "security": [
          {
            "githubOAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Todo id"
          }
        ],
        "responses": {
          "200": {
            "description": "Todo found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            }
          },
          "400": {
            "description": "Invalid todo id"
          },
          "401": {
            "description": "Unauthorized - you must be logged in"
          },
          "404": {
            "description": "Todo not found or does not belong to the logged-in user"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "put": {
        "tags": ["Todos"],
        "summary": "Update a todo by id",
        "description": "Requires login with GitHub OAuth. Updates the todo only if it belongs to the logged-in user.",
        "security": [
          {
            "githubOAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Todo id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TodoInput"
              },
              "example": {
                "title": "Study for exam",
                "description": "Review chapters 1 to 5",
                "completed": true,
                "priority": "medium",
                "dueDate": "2026-07-30",
                "categoryId": "507f1f77bcf86cd799439011"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Todo updated successfully"
          },
          "400": {
            "description": "Validation error - missing or invalid fields"
          },
          "401": {
            "description": "Unauthorized - you must be logged in"
          },
          "404": {
            "description": "Todo not found or does not belong to the logged-in user"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "delete": {
        "tags": ["Todos"],
        "summary": "Delete a todo by id",
        "description": "Requires login with GitHub OAuth. Deletes the todo only if it belongs to the logged-in user.",
        "security": [
          {
            "githubOAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Todo id"
          }
        ],
        "responses": {
          "200": {
            "description": "Todo deleted successfully"
          },
          "400": {
            "description": "Invalid todo id"
          },
          "401": {
            "description": "Unauthorized - you must be logged in"
          },
          "404": {
            "description": "Todo not found or does not belong to the logged-in user"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "githubOAuth": {
        "type": "oauth2",
        "description": "Login by visiting GET /login in the same browser. After GitHub authorizes you, a session cookie is created and Swagger Try it out will use that cookie automatically.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://github.com/login/oauth/authorize",
            "tokenUrl": "https://github.com/login/oauth/access_token",
            "scopes": {
              "user:email": "Access user email"
            }
          }
        }
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "507f1f77bcf86cd799439013"
          },
          "githubId": {
            "type": "string",
            "example": "12345678"
          },
          "username": {
            "type": "string",
            "example": "octocat"
          },
          "displayName": {
            "type": "string",
            "example": "The Octocat"
          }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "507f1f77bcf86cd799439011"
          },
          "name": {
            "type": "string",
            "example": "School"
          },
          "description": {
            "type": "string",
            "example": "Tasks related to school"
          },
          "color": {
            "type": "string",
            "example": "blue"
          }
        }
      },
      "CategoryInput": {
        "type": "object",
        "required": ["name", "description", "color"],
        "properties": {
          "name": {
            "type": "string",
            "example": "School"
          },
          "description": {
            "type": "string",
            "example": "Tasks related to school"
          },
          "color": {
            "type": "string",
            "example": "blue"
          }
        }
      },
      "Todo": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "507f1f77bcf86cd799439012"
          },
          "title": {
            "type": "string",
            "example": "Study for exam"
          },
          "description": {
            "type": "string",
            "example": "Review chapters 1 to 5"
          },
          "completed": {
            "type": "boolean",
            "example": false
          },
          "priority": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "example": "high"
          },
          "dueDate": {
            "type": "string",
            "example": "2026-07-25"
          },
          "categoryId": {
            "type": "string",
            "example": "507f1f77bcf86cd799439011"
          },
          "userId": {
            "type": "string",
            "description": "Id of the user who owns this todo",
            "example": "507f1f77bcf86cd799439013"
          }
        }
      },
      "TodoInput": {
        "type": "object",
        "required": ["title", "description", "completed", "priority", "dueDate", "categoryId"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Study for exam"
          },
          "description": {
            "type": "string",
            "example": "Review chapters 1 to 5"
          },
          "completed": {
            "type": "boolean",
            "example": false
          },
          "priority": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "example": "high"
          },
          "dueDate": {
            "type": "string",
            "example": "2026-07-25"
          },
          "categoryId": {
            "type": "string",
            "example": "507f1f77bcf86cd799439011"
          }
        }
      }
    }
  }
}
